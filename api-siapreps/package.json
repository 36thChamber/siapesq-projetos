{
  "name": "api-siapreps",
  "version": "0.0.1",
  "description": "API do SIAPREPS para cadastro, autenticacao e gerenciamento de usuarios",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node ./src/server.ts | npx pino-pretty",
    "build": "tsc && npm run build:openapi-bundled",
    "test": "vitest",
    "test:integration": "vitest --dir tests/integration",
    "test:migrations": "vitest run tests/migrations",
    "db:migrate": "sequelize-cli db:migrate --env migration",
    "db:migrate:status": "sequelize-cli db:migrate:status --env migration",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --env migration",
    "db:schema:compare": "node utils/compare-model-schema.cjs",
    "gen-docs": "node -e \"require('js-yaml').load(require('fs').readFileSync('docs/swagger.yaml','utf8')); console.log('Swagger YAML valido: docs/swagger.yaml')\"",
    "start": "node -r dotenv/config build/src/server.js dotenv_config_path=.env",
    "validate:openapi": "redocly lint --extends=minimal docs/openapi.yaml",
    "build:openapi-bundled": "redocly bundle docs/openapi.yaml --output docs/openapi-bundled.yaml"
  },
  "keywords": [],
  "author": "Chipskein",
  "devDependencies": {
    "@redocly/cli": "1.34.24",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.2",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^8.0.2",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid4": "^2.0.0",
    "@types/validator": "^13.7.17",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.378.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "joi": "^17.9.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.11.1",
    "pg-hstore": "^2.3.4",
    "pino-http": "^8.3.3",
    "pino-pretty": "^10.0.1",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.32.1",
    "sequelize-typescript": "^2.1.5",
    "swagger-ui-express": "^5.0.0",
    "uuid4": "^2.0.3"
  }
}
