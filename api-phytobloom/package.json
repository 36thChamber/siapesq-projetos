{
  "name": "api-phytobloom",
  "version": "0.0.1",
  "description": "API do aplicativo de monitoramento de corpos hidricos PhytoBloom",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node ./src/server.ts | npx pino-pretty",
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc && node -e \"require('fs').cpSync('src/templates','build/src/templates',{recursive:true})\"",
    "test": "vitest",
    "test:areas": "vitest run tests/integration/areas-alertas-ownership.test.ts",
    "seed:admin": "ts-node -r dotenv/config src/orm/seed-admin.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:schema:compare": "node utils/compare-model-schema.cjs",
    "gen-docs": "npm run docs:bundle",
    "docs:bundle": "npx --yes @redocly/cli bundle docs/openapi.yaml --output docs/openapi-bundled.yaml",
    "docs:lint": "npx --yes @redocly/cli lint docs/openapi.yaml",
    "docs:verify": "node utils/validate-openapi.cjs",
    "start": "node -r dotenv/config build/src/server.js dotenv_config_path=.env"
  },
  "keywords": [],
  "author": "Chipskein",
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/handlebars": "^4.0.40",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.2",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.15",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/validator": "^13.7.17",
    "pino-pretty": "^13.1.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.378.0",
    "@types/pg": "^8.23.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "handlebars": "^4.7.9",
    "joi": "^17.9.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino-http": "^8.3.3",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.0"
  }
}
