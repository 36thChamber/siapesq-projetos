{
  "compilerOptions": {
    "strict": true,
    "types": ["node", "react"],
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/services/api/gbif.service": ["./gbif.service.ts"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
