{
  "name": "api-plataforma-siapesq",
  "version": "1.0.0",
  "description": "API da plataforma de monitoramento ambiental SIAPESQ",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node ./src/server.ts | npx pino-pretty",
    "build": "node utils/build.cjs",
    "test": "vitest",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "gen-docs": "node utils/bundle-openapi.js",
    "start": "node -r dotenv/config build/server.js dotenv_config_path=.env"
  },
  "author": "thgularte",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.19.41",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.15",
    "@types/sequelize": "^4.28.20",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid4": "^2.0.0",
    "@types/validator": "^13.7.17",
    "pino-pretty": "^10.0.1",
    "sequelize-cli": "^6.6.5",
    "swagger-autogen": "^2.23.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.378.0",
    "@aws-sdk/s3-request-presigner": "3.1030.0",
    "@types/dotenv": "^6.1.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cookies": "^0.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.8",
    "joi": "^17.9.2",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.11.1",
    "pg-hstore": "^2.3.4",
    "pino-http": "^8.3.3",
    "reflect-metadata": "^0.1.14",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.0",
